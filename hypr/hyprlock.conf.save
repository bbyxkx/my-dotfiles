background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 7
    brightness = 0.5
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = rgb(171, 178, 191)
    font_size = 64
    font_family = JetBrainsMono Nerd Font
    position = 0, 160
    halign = center
    valign = center
}

label {
    monitor =
    text = $USER
    color = rgb(171, 178, 191)
    font_size = 24
    font_family = JetBrainsMono Nerd Font
    position = 0, 60
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 50
    outline_thickness = 2
    outer_color = rgb(61afef)
    inner_color = rgb(282c34)
    font_color = rgb(abb2bf)
    placeholder_text = <i>Password...</i>
    position = 0, -100
    halign = center
    valign = center
